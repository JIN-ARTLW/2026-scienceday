# 복사해서 .env로 저장하고 값을 채운다 (.env는 git에 올라가지 않음)

# 공용 데이터·결과 폴더 (Google Drive). 두 컴퓨터가 같은 Drive 폴더를 가리키게 한다.
# 이 폴더 아래에 raw/, processed/(밀도 캐시, 모델 결과)가 만들어진다.
# 맥 예:     SCIENCEDAY_DATA_DIR=/Users/<이름>/Library/CloudStorage/GoogleDrive-<메일>/내 드라이브/2026-scienceday/data
# 윈도우 예: SCIENCEDAY_DATA_DIR=G:\내 드라이브\2026-scienceday\data
SCIENCEDAY_DATA_DIR=./data

# Space-Track 계정 (본인 것만, 공유 금지)
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=
